{
    "name": "nigelrel3/filament-blueprint-addon",
    "description": "",
    "keywords": [
        "laravel",
        "filament",
        "blueprint"
    ],
    "homepage": "https://github.com/NigelRel3/filament-blueprint-addon",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Nigel Rudd",
            "email": "nigelrel3@yahoo.co.uk",
            "role": "Developer"
        }
